# Absolute writable directory on the target machine. It stores generated runtime
# copies, logs, caches, factual banks, predictions, and checkpoints; it is not Git data.
WAM2REPAIR_ROOT=/absolute/path/to/wam2repair-data

# Clone locations and externally acquired dependencies.
WAM2REPAIR_REPO=/absolute/path/to/WAM2Repair
LIBERO_ROOT=/absolute/path/to/LIBERO
FASTWAM_ROOT=/absolute/path/to/FastWAM
OPENPI_ROOT=/absolute/path/to/openpi

# Checkpoints are never stored in this repository.
PI05_CHECKPOINT=/absolute/path/to/pi05_checkpoint
FASTWAM_ACTION_DIT_CHECKPOINT=/absolute/path/to/action_dit_checkpoint.pt

# Optional runtime choices.
WAM2REPAIR_USER=your_login_name
CUDA_VISIBLE_DEVICES=0
